TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional fallback only if you intentionally use RLS-compatible anon access.
SUPABASE_ANON_KEY=
CRON_SECRET=
# Support flow switch: old keeps the current ticket flow, ai enables draft auto-response templates.
SUPPORT_MODE=old
# Team inbox: forward support messages in TEAM_STATS_GROUP_CHAT_IDS from non-registered users to registered team members via DM (.set "off" to disable).
TEAM_INBOX_MODE=on

# Object storage for photo attachments (proof of work + support tickets).
# supabase (default) keeps using Supabase Storage; r2 stores objects in Cloudflare R2.
STORAGE_DRIVER=supabase
# Required only when STORAGE_DRIVER=r2.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Public bucket URL or custom domain, e.g. https://pub-xxxx.r2.dev or https://media.example.com
R2_PUBLIC_BASE_URL=
