{
  "crons": [
    {
      "path": "/api/cron/daily-report",
      "schedule": "5 1 * * *"
    },
    {
      "path": "/api/cron/repeated-issue-report",
      "schedule": "15 1 * * *"
    },
    {
      "path": "/api/cron/daily-report?spam=weekly",
      "schedule": "5 16 * * 0"
    },
    {
      "path": "/api/cron/daily-report?spam=monthly",
      "schedule": "5 0 1 * *"
    }
  ]
}
